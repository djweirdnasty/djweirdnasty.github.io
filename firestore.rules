rules_version = '2';

// SOL (Sounds of Logan) DJ booking app — Firestore security rules.
//
// Derived from every db.collection(...) call in sol.html / functions/index.js.
// Booking documents are created exclusively by the trusted external backend
// (rork-dj-booking-payment-app.onrender.com) using the Firebase Admin SDK,
// which bypasses these rules entirely — so `create` on bookings is blocked
// here for regular clients. Cloud Functions (functions/index.js) also use
// the Admin SDK and are unaffected by these rules.
//
// IMPORTANT: test every app flow (client booking, DJ console, admin console)
// after deploying this. If something breaks, loosen the specific rule that
// blocks it rather than reverting the whole file.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Mirrors the client-side admin check in sol.html (ADMIN_UID / ADMIN_EMAIL).
    // Privilege is determined by auth identity, not by a mutable Firestore field.
    function isAdmin() {
      return isSignedIn() && (
        request.auth.uid == '3i7fQdPjN0Qxz3FysVPvnhtxzlJ3' ||
        request.auth.token.email == 'djweirdnasty@gmail.com'
      );
    }

    function unchanged(field) {
      return request.resource.data.get(field, null) == resource.data.get(field, null);
    }

    // The site owner flag is stored on the user document and managed server-side.
    function isProtectedAdmin(uid) {
      return exists(/databases/$(database)/documents/users/$(uid)) &&
        get(/databases/$(database)/documents/users/$(uid)).data.get('protected', false) == true;
    }

    function isEmailVerified() {
      return request.auth.token.email_verified == true;
    }

    function stringWithin(field, max) {
      return !(field in request.resource.data) ||
        (request.resource.data[field] is string && request.resource.data[field].size() <= max);
    }

    // True when the owner of users/{ownerId} has `senderId` in their
    // blockedUsers array — used to enforce chat blocking server-side.
    function userHasBlocked(ownerId, senderId) {
      return exists(/databases/$(database)/documents/users/$(ownerId)) &&
        senderId in get(/databases/$(database)/documents/users/$(ownerId)).data.get('blockedUsers', []);
    }

    // True when another participant in the conversation blocked `senderId`.
    // `participants` is the canonical field (written by the web app);
    // app-created docs fall back to clientId/djId. 1:1 conversations only.
    function isBlockedByParticipant(conversationId, senderId) {
      let convo = get(/databases/$(database)/documents/conversations/$(conversationId)).data;
      let p = convo.get('participants', [convo.get('clientId', ''), convo.get('djId', '')]);
      return (p.size() > 0 && p[0] != senderId && userHasBlocked(p[0], senderId)) ||
             (p.size() > 1 && p[1] != senderId && userHasBlocked(p[1], senderId));
    }

    // ---------- users ----------
    // Owner can manage their own profile, but can never grant themselves
    // admin/verified/unbanned status — those are admin-only fields.
    // The site owner account is protected from being banned or un-adminned.
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid) &&
        request.resource.data.get('isAdmin', false) == false &&
        request.resource.data.get('banned', false) == false &&
        request.resource.data.get('protected', false) == false;
      allow update: if (
        isProtectedAdmin(uid) &&
        resource.data.get('isAdmin', false) == true &&
        request.resource.data.get('isAdmin', resource.data.get('isAdmin', false)) == true &&
        request.resource.data.get('banned', resource.data.get('banned', false)) == false
      ) || (
        !isProtectedAdmin(uid) && (isAdmin() || (
          isOwner(uid) &&
          unchanged('isAdmin') &&
          unchanged('banned') &&
          unchanged('isVerifiedDJ') &&
          unchanged('protected')
        ))
      );
      allow delete: if isAdmin() && !isProtectedAdmin(uid);
    }

    // ---------- DJ profile & verification ----------
    match /djs/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      // Stripe Connect fields are managed only by the callable functions
      // (Admin SDK) — owners may not set or change them, so a DJ can't point
      // payouts at an account that isn't theirs or forge an enabled flag.
      allow create: if isAdmin() || (
        isOwner(uid) &&
        !request.resource.data.keys().hasAny(['stripeAccountId', 'stripePayoutsEnabled', 'stripeDetailsSubmitted'])
      );
      allow update: if isAdmin() || (
        isOwner(uid) &&
        unchanged('stripeAccountId') &&
        unchanged('stripePayoutsEnabled') &&
        unchanged('stripeDetailsSubmitted')
      );
      allow delete: if isOwner(uid) || isAdmin();
    }

    // ---------- Public DJ directory (non-PII projection) ----------
    match /publicDjs/{uid} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Contains phone/PayPal/profile info submitted for review.
    // A DJ can create/update their own submission, but only admin can
    // move status away from 'pending' (i.e. approve/reject).
    match /dj-verifications/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isAdmin() || (isOwner(uid) && request.resource.data.get('status', 'pending') == 'pending');
      allow update: if isAdmin() || (
        isOwner(uid) &&
        request.resource.data.get('status', 'pending') == resource.data.get('status', 'pending')
      );
      allow delete: if isAdmin();
    }

    match /dj-status/{uid} {
      allow read: if isSignedIn();
      allow create: if isOwner(uid) || isAdmin();
      allow update: if isAdmin() || (
        isOwner(uid) &&
        unchanged('isVerified') &&
        unchanged('verifiedAt')
      );
      allow delete: if isAdmin();
    }

    match /dj-availability/{uid} {
      allow read: if isSignedIn();
      allow write: if isOwner(uid) || isAdmin();
    }

    match /dj-galleries/{uid} {
      allow read: if isSignedIn();
      allow write: if isOwner(uid) || isAdmin();
    }

    match /dj-samples/{uid} {
      allow read: if isSignedIn();
      allow write: if isOwner(uid) || isAdmin();
    }

    match /dj-videos/{uid} {
      allow read: if isSignedIn();
      allow write: if isOwner(uid) || isAdmin();
    }

    match /dj-events/{uid} {
      allow read: if isSignedIn();
      allow write: if isOwner(uid) || isAdmin();
    }

    // DJ-to-DJ networking messages.
    match /dj-messages/{id} {
      allow read: if isSignedIn() && (
        resource.data.fromUid == request.auth.uid ||
        resource.data.toUid == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn() &&
        request.resource.data.fromUid == request.auth.uid &&
        stringWithin('message', 2000);
      allow update, delete: if isAdmin();
    }

    // Client verification (KYC-lite: name, phone, ID photo URL). Sensitive PII —
    // owner-only, and only admin can approve/reject.
    match /client-verifications/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isAdmin() || (isOwner(uid) && request.resource.data.get('status', 'pending') == 'pending');
      allow update: if isAdmin() || (
        isOwner(uid) &&
        request.resource.data.get('status', 'pending') == resource.data.get('status', 'pending')
      );
      allow delete: if isAdmin();
    }

    // ---------- Bookings ----------
    // Created only by the trusted external backend via the Admin SDK
    // (bypasses these rules). Blocking client `create` here prevents
    // anyone from forging a booking document directly.
    match /bookings/{id} {
      allow read: if isSignedIn() && (
        resource.data.get('djId', null) == request.auth.uid ||
        resource.data.get('clientId', null) == request.auth.uid ||
        resource.data.get('client_id', null) == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAdmin() || (
        isSignedIn() && isEmailVerified() && (
          // Client creating a pending booking request for themselves
          (request.resource.data.get('clientId', null) == request.auth.uid &&
           request.resource.data.get('status', 'pending') == 'pending') ||
          // DJ creating the confirmed booking when accepting a request
          (request.resource.data.get('djId', null) == request.auth.uid &&
           request.resource.data.get('status', 'pending') in ['pending', 'confirmed'])
        ) &&
        // Payment/payout state can never be forged at creation
        request.resource.data.get('payoutSent', false) == false &&
        request.resource.data.get('depositPayoutSent', false) == false &&
        request.resource.data.get('finalPayoutSent', false) == false &&
        !request.resource.data.keys().hasAny(['stripeTransferId', 'payoutBatchId', 'payoutAt'])
      );
      allow update: if isAdmin() || (
        // Updates are already constrained to the booking's two parties plus
        // the forward-only lifecycle below, so they do not require a verified
        // email — otherwise clients who never clicked the verification link
        // could not cancel or manage their own bookings. Verification is
        // still required to CREATE bookings (anti-spam).
        isSignedIn() &&
        // Only the two parties may update — a DJ may also claim a booking
        // whose djId was never assigned (open broadcast requests).
        (
          resource.data.get('djId', null) == request.auth.uid ||
          resource.data.get('clientId', null) == request.auth.uid ||
          resource.data.get('client_id', null) == request.auth.uid ||
          (resource.data.get('djId', null) == null && request.resource.data.get('djId', null) == request.auth.uid)
        ) &&
        (
          // Status unchanged — covers non-status writes like tips, notes,
          // counter-offers, and timer flags.
          resource.data.get('status', 'pending') == request.resource.data.get('status', resource.data.get('status', 'pending')) ||
          // Either party may cancel from any non-terminal state. The app's
          // lifecycle continues well past 'confirmed' (lets_go, on_the_way,
          // arrived, started) and users must be able to cancel throughout.
          (request.resource.data.get('status', 'pending') == 'cancelled' &&
           resource.data.get('status', 'pending') in ['pending', 'confirmed', 'lets_go', 'on_the_way', 'arrived', 'started']) ||
          // Forward-only lifecycle progression. 'arrived' is allowed from
          // confirmed/lets_go too because a DJ may confirm arrival before any
          // GPS update has flipped the status to on_the_way.
          (resource.data.get('status', 'pending') == 'pending' && request.resource.data.get('status', 'pending') == 'confirmed') ||
          (resource.data.get('status', 'pending') == 'confirmed' && request.resource.data.get('status', 'pending') in ['lets_go', 'on_the_way', 'arrived', 'completed']) ||
          (resource.data.get('status', 'pending') == 'lets_go' && request.resource.data.get('status', 'pending') in ['on_the_way', 'arrived']) ||
          (resource.data.get('status', 'pending') == 'on_the_way' && request.resource.data.get('status', 'pending') in ['arrived', 'completed']) ||
          (resource.data.get('status', 'pending') == 'arrived' && request.resource.data.get('status', 'pending') in ['started', 'completed']) ||
          (resource.data.get('status', 'pending') == 'started' && request.resource.data.get('status', 'pending') == 'completed')
        ) &&
        (
          resource.data.get('djId', null) == request.resource.data.get('djId', resource.data.get('djId', null)) ||
          (resource.data.get('djId', null) == null && request.resource.data.get('djId', null) == request.auth.uid)
        ) &&
        unchanged('clientId') &&
        unchanged('client_id') &&
        unchanged('totalAmount') &&
        unchanged('total_cost') &&
        unchanged('deposit_only') &&
        unchanged('payoutSent') &&
        unchanged('depositPayoutSent') &&
        unchanged('finalPayoutSent') &&
        unchanged('payoutBatchId') &&
        unchanged('stripeTransferId') &&
        unchanged('payoutStatus') &&
        unchanged('payoutAt') &&
        unchanged('refundAmount') &&
        unchanged('refund') &&
        // cancelledBy may only be written as the caller's own uid — it is an
        // audit field, so parties can record their cancellation but can never
        // attribute it to someone else.
        (unchanged('cancelledBy') ||
         request.resource.data.get('cancelledBy', null) == request.auth.uid) &&
        unchanged('createdAt')
      );
      allow delete: if isAdmin();
    }

    // ---------- Broadcast booking requests ----------
    // The app's quick-book flow writes one broadcast doc here, then fans out
    // per-DJ pending-requests. Any signed-in DJ may read an open request;
    // DJs can only mark themselves as viewing/interested.
    match /booking-requests/{id} {
      allow read: if isSignedIn() && (
        resource.data.get('clientId', null) == request.auth.uid ||
        resource.data.get('status', 'pending') == 'pending' ||
        isAdmin()
      );
      allow create: if isSignedIn() &&
        request.resource.data.get('clientId', null) == request.auth.uid &&
        request.resource.data.get('status', 'pending') == 'pending';
      allow update: if isAdmin() || (
        isSignedIn() &&
        unchanged('clientId') &&
        (
          resource.data.get('clientId', null) == request.auth.uid ||
          (
            resource.data.get('status', 'pending') == 'pending' &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['viewedBy', 'interestedDJs', 'updatedAt'])
          )
        )
      );
      allow delete: if isAdmin();
    }

    // Written only by the sendPaypalPayout Cloud Function (Admin SDK).
    match /payouts/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ---------- Disputes ----------
    match /disputes/{id} {
      allow read: if isSignedIn() && (resource.data.clientId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isEmailVerified() && request.resource.data.clientId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // ---------- Reviews ----------
    // A review must reference a completed booking the reviewer was a party to.
    function isBookingParty(bookingId, uid) {
      return exists(/databases/$(database)/documents/bookings/$(bookingId)) && (
        get(/databases/$(database)/documents/bookings/$(bookingId)).data.get('clientId', null) == uid ||
        get(/databases/$(database)/documents/bookings/$(bookingId)).data.get('djId', null) == uid
      );
    }
    match /feedback/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        isEmailVerified() &&
        request.resource.data.fromUserId == request.auth.uid &&
        request.resource.data.bookingId is string &&
        request.resource.data.rating is int &&
        request.resource.data.rating >= 0 &&
        request.resource.data.rating <= 5 &&
        stringWithin('review', 2000) &&
        isBookingParty(request.resource.data.bookingId, request.auth.uid) &&
        get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.get('status', null) == 'completed';
      allow update, delete: if isAdmin();
    }

    // ---------- Tips ----------
    match /tips/{id} {
      allow read: if isSignedIn() && (resource.data.clientId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isEmailVerified() && request.resource.data.clientId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // ---------- Song requests / setlists (tied to a booking, low sensitivity) ----------
    match /playlists/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow delete: if isSignedIn() || isAdmin();
      allow update: if isAdmin();
    }

    match /setlists/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow delete: if isSignedIn() || isAdmin();
      allow update: if isAdmin();
    }

    // ---------- Saved DJs (client bookmarks) ----------
    match /saved-djs/{id} {
      allow read: if isSignedIn() && (resource.data.clientId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.clientId == request.auth.uid;
      allow delete: if isSignedIn() && (resource.data.clientId == request.auth.uid || isAdmin());
      allow update: if isAdmin();
    }

    // ---------- DJ waitlist ----------
    match /waitlist/{id} {
      allow read: if isSignedIn() && (
        resource.data.get('djId', null) == request.auth.uid ||
        resource.data.get('clientId', null) == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn();
      allow update: if isAdmin() || (isSignedIn() && resource.data.get('djId', null) == request.auth.uid);
      allow delete: if isAdmin();
    }

    // ---------- Client <-> DJ chat ----------
    match /conversations/{conversationId} {
      allow read, update: if isSignedIn() && (
        request.auth.uid in resource.data.get('participants', []) ||
        request.auth.uid == resource.data.get('clientId', '') ||
        request.auth.uid == resource.data.get('djId', '') ||
        isAdmin()
      );
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.get('participants', []);
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isSignedIn() && (
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.get('participants', []) ||
          request.auth.uid == get(/databases/$(database)/documents/conversations/$(conversationId)).data.get('clientId', '') ||
          request.auth.uid == get(/databases/$(database)/documents/conversations/$(conversationId)).data.get('djId', '') ||
          isAdmin()
        );
        allow create: if isSignedIn() &&
          request.resource.data.senderId == request.auth.uid &&
          stringWithin('text', 2000) &&
          !isBlockedByParticipant(conversationId, request.auth.uid);
        allow update, delete: if isAdmin();
      }
    }

    // ---------- Admin broadcasts & messages ----------
    match /admin_broadcasts/{id} {
      allow read: if isAdmin();
      allow create: if false; // created only by Cloud Function admin SDK
      allow update, delete: if isAdmin();
    }

    // ---------- Admin-only site config & promo codes ----------
    match /config/{id} {
      allow read, write: if false; // Credentials migrated to Cloud Functions environment; no client access
    }

    match /promo-codes/{code} {
      allow read: if isAdmin(); // Client promo validation now goes through redeemPromo callable
      allow write: if isAdmin();
    }

    // ---------- Push notification subscriptions ----------
    match /push-subscriptions/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isOwner(uid) || isAdmin();
    }

    // DJ like/dislike feedback on suggested songs (create-only; admin/SDK reads).
    match /songFeedback/{id} {
      allow create: if request.auth != null;
      allow read, update, delete: if false;
    }

    // Admin-curated song suggestions pushed to every DJ's console queue.
    // Any signed-in user (DJs) can read; only the site admin can add/remove.
    match /songSuggestions/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Indie artist rotation playback notifications (create-only; admin/SDK reads).
    match /indie-playback-notifications/{id} {
      allow create: if request.auth != null;
      allow read, update, delete: if false;
    }

    // ---------- Pending booking requests (mobile app) ----------
    // Lightweight notification docs the app writes alongside bookings so DJs
    // get a real-time "new request" ping. Mirrors bookings access: client
    // creates for themselves, both parties can read, either can update
    // status/read flags, admin has full access.
    match /pending-requests/{id} {
      allow read: if isSignedIn() && (
        resource.data.get('djId', null) == request.auth.uid ||
        resource.data.get('clientId', null) == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn() &&
        request.resource.data.get('clientId', null) == request.auth.uid &&
        request.resource.data.get('status', 'pending') == 'pending';
      allow update: if isAdmin() || (
        isSignedIn() && (
          resource.data.get('djId', null) == request.auth.uid ||
          resource.data.get('clientId', null) == request.auth.uid
        ) &&
        unchanged('clientId') &&
        unchanged('djId')
      );
      allow delete: if isAdmin();
    }

    // ---------- Mobile admin panel collections ----------
    // Read by the app's AdminContext. admin-users holds per-admin permission
    // records; system-stats and admin-actions back the admin dashboard.
    match /admin-users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isAdmin();
    }

    match /system-stats/{id} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /admin-actions/{id} {
      allow read, write: if isAdmin();
    }

    // ---------- Abuse reports (UGC moderation for App Store review) ----------
    // Any signed-in user can file a report against another user; only the
    // site admin can read or resolve them.
    match /reports/{id} {
      allow read: if isAdmin();
      allow create: if isSignedIn() &&
        request.resource.data.reporterId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // ---------- In-app notifications ----------
    // Notification docs are addressed via recipientId (userId kept for
    // legacy readers). Any signed-in user may create a notification for
    // someone else; only the recipient can read/update/delete it.
    match /notifications/{id} {
      allow read, update, delete: if isAdmin() || (
        isSignedIn() && (
          resource.data.get('recipientId', null) == request.auth.uid ||
          resource.data.get('userId', null) == request.auth.uid
        )
      );
      allow create: if isSignedIn();
    }

    // ---------- Typing indicators ----------
    // Doc ids are {conversationId}_{uid}. Presence is low-sensitivity —
    // any signed-in user may read, but only the owner may write their doc.
    match /typing/{id} {
      allow read: if isSignedIn();
      // On create the userId comes from the request; on partial updates
      // (e.g. timestamp-only) fall back to the existing doc's userId.
      allow write: if isSignedIn() &&
        request.resource.data.get('userId', resource.data.get('userId', null)) == request.auth.uid;
    }

    // ---------- User presence ----------
    // Doc id is the user's uid; only the owner writes their last-seen.
    match /user-status/{uid} {
      allow read: if isSignedIn();
      allow write: if isOwner(uid) || isAdmin();
    }

    // Default deny for anything not explicitly matched above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
