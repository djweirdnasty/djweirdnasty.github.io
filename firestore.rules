rules_version = '2';

// SOL (Sounds of Logan) DJ booking app — Firestore security rules.
//
// Derived from every db.collection(...) call in sol.html / functions/index.js.
// Booking documents are created exclusively by the trusted external backend
// (rork-dj-booking-payment-app.onrender.com) using the Firebase Admin SDK,
// which bypasses these rules entirely — so `create` on bookings is blocked
// here for regular clients. Cloud Functions (functions/index.js) also use
// the Admin SDK and are unaffected by these rules.
//
// IMPORTANT: test every app flow (client booking, DJ console, admin console)
// after deploying this. If something breaks, loosen the specific rule that
// blocks it rather than reverting the whole file.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Mirrors the client-side admin check in sol.html (ADMIN_UID / ADMIN_EMAIL).
    // Privilege is determined by auth identity, not by a mutable Firestore field.
    function isAdmin() {
      return isSignedIn() && (
        request.auth.uid == '3i7fQdPjN0Qxz3FysVPvnhtxzlJ3' ||
        request.auth.token.email == 'djweirdnasty@gmail.com'
      );
    }

    function unchanged(field) {
      return request.resource.data.get(field, null) == resource.data.get(field, null);
    }

    // The site owner's account can never lose admin or be banned.
    function isProtectedAdmin(uid) {
      return uid == '3i7fQdPjN0Qxz3FysVPvnhtxzlJ3';
    }

    // ---------- users ----------
    // Owner can manage their own profile, but can never grant themselves
    // admin/verified/unbanned status — those are admin-only fields.
    // The site owner's admin flag is permanent and cannot be banned.
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid) &&
        request.resource.data.get('isAdmin', false) == false &&
        request.resource.data.get('banned', false) == false;
      allow update: if (
        isProtectedAdmin(uid) &&
        request.resource.data.get('isAdmin', false) == true &&
        request.resource.data.get('banned', false) == false
      ) || (
        !isProtectedAdmin(uid) && (isAdmin() || (
          isOwner(uid) &&
          unchanged('isAdmin') &&
          unchanged('banned') &&
          unchanged('isVerifiedDJ')
        ))
      );
      allow delete: if isAdmin() && !isProtectedAdmin(uid);
    }

    // ---------- DJ profile & verification ----------
    match /djs/{uid} {
      allow read: if isSignedIn();
      allow write: if isOwner(uid) || isAdmin();
    }

    // Contains phone/PayPal/profile info submitted for review.
    // A DJ can create/update their own submission, but only admin can
    // move status away from 'pending' (i.e. approve/reject).
    match /dj-verifications/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isAdmin() || (isOwner(uid) && request.resource.data.get('status', 'pending') == 'pending');
      allow update: if isAdmin() || (
        isOwner(uid) &&
        request.resource.data.get('status', 'pending') == resource.data.get('status', 'pending')
      );
      allow delete: if isAdmin();
    }

    match /dj-status/{uid} {
      allow read: if isSignedIn();
      allow create: if isOwner(uid) || isAdmin();
      allow update: if isAdmin() || (
        isOwner(uid) &&
        unchanged('isVerified') &&
        unchanged('verifiedAt')
      );
      allow delete: if isAdmin();
    }

    match /dj-availability/{uid} {
      allow read: if isSignedIn();
      allow write: if isOwner(uid) || isAdmin();
    }

    match /dj-galleries/{uid} {
      allow read: if isSignedIn();
      allow write: if isOwner(uid) || isAdmin();
    }

    match /dj-samples/{uid} {
      allow read: if isSignedIn();
      allow write: if isOwner(uid) || isAdmin();
    }

    match /dj-videos/{uid} {
      allow read: if isSignedIn();
      allow write: if isOwner(uid) || isAdmin();
    }

    // DJ-to-DJ networking messages.
    match /dj-messages/{id} {
      allow read: if isSignedIn() && (
        resource.data.fromUid == request.auth.uid ||
        resource.data.toUid == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn() && request.resource.data.fromUid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Client verification (KYC-lite: name, phone, ID photo URL). Sensitive PII —
    // owner-only, and only admin can approve/reject.
    match /client-verifications/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isAdmin() || (isOwner(uid) && request.resource.data.get('status', 'pending') == 'pending');
      allow update: if isAdmin() || (
        isOwner(uid) &&
        request.resource.data.get('status', 'pending') == resource.data.get('status', 'pending')
      );
      allow delete: if isAdmin();
    }

    // ---------- Bookings ----------
    // Created only by the trusted external backend via the Admin SDK
    // (bypasses these rules). Blocking client `create` here prevents
    // anyone from forging a booking document directly.
    match /bookings/{id} {
      allow read: if isSignedIn() && (
        resource.data.get('djId', null) == request.auth.uid ||
        resource.data.get('clientId', null) == request.auth.uid ||
        resource.data.get('client_id', null) == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAdmin();
      allow update: if isAdmin() || (
        isSignedIn() &&
        (
          resource.data.get('status', 'pending') == request.resource.data.get('status', resource.data.get('status', 'pending')) ||
          (resource.data.get('status', 'pending') == 'pending' && (request.resource.data.get('status', 'pending') == 'confirmed' || request.resource.data.get('status', 'pending') == 'cancelled')) ||
          (resource.data.get('status', 'pending') == 'confirmed' && (request.resource.data.get('status', 'pending') == 'completed' || request.resource.data.get('status', 'pending') == 'cancelled'))
        ) &&
        (
          resource.data.get('djId', null) == request.resource.data.get('djId', resource.data.get('djId', null)) ||
          (resource.data.get('djId', null) == null && request.resource.data.get('djId', null) == request.auth.uid)
        ) &&
        unchanged('clientId') &&
        unchanged('client_id') &&
        unchanged('totalAmount') &&
        unchanged('total_cost') &&
        unchanged('deposit_only') &&
        unchanged('payoutSent') &&
        unchanged('depositPayoutSent') &&
        unchanged('finalPayoutSent') &&
        unchanged('payoutBatchId') &&
        unchanged('refundAmount') &&
        unchanged('refund') &&
        unchanged('cancelledBy') &&
        unchanged('createdAt')
      );
      allow delete: if isAdmin();
    }

    // Written only by the sendPaypalPayout Cloud Function (Admin SDK).
    match /payouts/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ---------- Disputes ----------
    match /disputes/{id} {
      allow read: if isSignedIn() && (resource.data.clientId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.clientId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // ---------- Reviews ----------
    // A review must reference a completed booking the reviewer was a party to.
    function isBookingParty(bookingId, uid) {
      return exists(/databases/$(database)/documents/bookings/$(bookingId)) && (
        get(/databases/$(database)/documents/bookings/$(bookingId)).data.get('clientId', null) == uid ||
        get(/databases/$(database)/documents/bookings/$(bookingId)).data.get('djId', null) == uid
      );
    }
    match /feedback/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        request.resource.data.fromUserId == request.auth.uid &&
        request.resource.data.bookingId is string &&
        isBookingParty(request.resource.data.bookingId, request.auth.uid) &&
        get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.get('status', null) == 'completed';
      allow update, delete: if isAdmin();
    }

    // ---------- Tips ----------
    match /tips/{id} {
      allow read: if isSignedIn() && (resource.data.clientId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.clientId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // ---------- Song requests / setlists (tied to a booking, low sensitivity) ----------
    match /playlists/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow delete: if isSignedIn() || isAdmin();
      allow update: if isAdmin();
    }

    match /setlists/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow delete: if isSignedIn() || isAdmin();
      allow update: if isAdmin();
    }

    // ---------- Saved DJs (client bookmarks) ----------
    match /saved-djs/{id} {
      allow read: if isSignedIn() && (resource.data.clientId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.clientId == request.auth.uid;
      allow delete: if isSignedIn() && (resource.data.clientId == request.auth.uid || isAdmin());
      allow update: if isAdmin();
    }

    // ---------- DJ waitlist ----------
    match /waitlist/{id} {
      allow read: if isSignedIn() && (
        resource.data.get('djId', null) == request.auth.uid ||
        resource.data.get('clientId', null) == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn();
      allow update: if isAdmin() || (isSignedIn() && resource.data.get('djId', null) == request.auth.uid);
      allow delete: if isAdmin();
    }

    // ---------- Client <-> DJ chat ----------
    match /conversations/{conversationId} {
      allow read, update: if isSignedIn() && (
        request.auth.uid in resource.data.get('participants', []) || isAdmin()
      );
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.get('participants', []);
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isSignedIn() && (
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.get('participants', []) ||
          isAdmin()
        );
        allow create: if isSignedIn() && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if isAdmin();
      }
    }

    // ---------- Admin broadcasts & messages ----------
    match /admin_broadcasts/{id} {
      allow read: if isAdmin();
      allow create: if false; // created only by Cloud Function admin SDK
      allow update, delete: if isAdmin();
    }

    // ---------- Admin-only site config & promo codes ----------
    match /config/{id} {
      allow read, write: if false; // Credentials migrated to Cloud Functions environment; no client access
    }

    match /promo-codes/{code} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ---------- Push notification subscriptions ----------
    match /push-subscriptions/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isOwner(uid) || isAdmin();
    }

    // Default deny for anything not explicitly matched above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
