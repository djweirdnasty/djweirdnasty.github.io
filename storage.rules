rules_version = '2';
// SOL DJ Booking — Firebase Storage security rules.
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    function isAdmin() {
      return isSignedIn() && (
        request.auth.uid == '3i7fQdPjN0Qxz3FysVPvnhtxzlJ3' ||
        request.auth.token.email == 'djweirdnasty@gmail.com'
      );
    }

    // DJ avatars, galleries, samples, videos — users can write only their own.
    // Constrain to media types and a 5 MB cap per object.
    match /djs/{uid}/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if (isOwner(uid) || isAdmin()) &&
        request.resource.size < 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*|audio/.*|video/.*|application/pdf');
    }

    // Client-specific uploads (ID verification, etc.) — owner or admin.
    // Constrain to images/PDF and a 2 MB cap.
    match /clients/{uid}/{allPaths=**} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if (isOwner(uid) || isAdmin()) &&
        request.resource.size < 2 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*|application/pdf');
    }

    // Catch-all: deny by default.
    match /{allPaths=**} {
      allow read, write: if isAdmin();
    }
  }
}
