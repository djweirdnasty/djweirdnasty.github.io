rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.uid == '3i7fQdPjN0Qxz3FysVPvnhtxzlJ3' ||
        request.auth.token.email == 'djweirdnasty@gmail.com'
      );
    }

    // Driver's licenses — private: owner and admin only. Images/PDF, 5 MB cap.
    match /licenses/{userId}/{allPaths=**} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) &&
        request.resource.size < 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*|application/pdf');
    }

    // Client verification uploads — private: owner and admin only.
    match /clients/{userId}/{allPaths=**} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) &&
        request.resource.size < 2 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*|application/pdf');
    }

    match /profile-pictures/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isOwner(userId);
    }
    
    match /header-photos/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isOwner(userId);
    }
    
    match /users/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isOwner(userId);
    }
    
    match /djs/{djId}/{allPaths=**} {
      allow read: if true;
      allow write: if isOwner(djId) || isAdmin();
    }

    // DJ portfolio gallery — public read (shown on profiles), owner write.
    match /portfolio/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isOwner(userId) &&
        request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }

    // Event photos uploaded against a booking — parties only.
    match /event-photos/{bookingId}/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (
        resource == null ||
        firestore.get(/databases/$(database)/documents/bookings/$(bookingId)).data.clientId == request.auth.uid ||
        firestore.get(/databases/$(database)/documents/bookings/$(bookingId)).data.djId == request.auth.uid
      );
    }

    // Voice messages inside a chat — conversation participants only.
    match /voice-messages/{conversationId}/{allPaths=**} {
      allow read, write: if isAuthenticated() &&
        request.auth.uid in firestore.get(/databases/$(database)/documents/conversations/$(conversationId)).data.get('participantIds', []);
    }
    
    match /bookings/{bookingId}/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (
        resource == null ||
        firestore.get(/databases/$(database)/documents/bookings/$(bookingId)).data.clientId == request.auth.uid ||
        firestore.get(/databases/$(database)/documents/bookings/$(bookingId)).data.djId == request.auth.uid
      );
    }
    
    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
