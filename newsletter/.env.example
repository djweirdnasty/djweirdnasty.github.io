# Copy this file to .env and fill in your values

# Generate a random secret: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-secret

# Resend API key from https://resend.com/api-keys
# Free tier: 3,000 emails/month, 100 emails/day
RESEND_API_KEY=re_your_api_key_here

# The email address you send newsletters from
# For testing: use onboarding@resend.dev (no domain verification needed)
# For production: verify your domain in Resend, then use newsletter@djweirdnasty.com
FROM_EMAIL=onboarding@resend.dev
FROM_NAME=DJWEIRDNASTY

# Admin credentials (change these!)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# CORS — your website URL
WEBSITE_URL=https://djweirdnasty.com

# Database (SQLite file path)
DATABASE_URL=sqlite:///./newsletter.db
