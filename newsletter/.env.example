# Copy this file to .env and fill in your values

# Generate a random secret: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-secret

# SMTP server config — use your own mail server or Amazon SES
# Amazon SES: host=email-smtp.us-east-1.amazonaws.com, port=587, TLS=true
# Gmail: host=smtp.gmail.com, port=587, TLS=true (use App Password)
# Your own server: host=mail.yourdomain.com, port=587, TLS=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=djweirdnasty@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_USE_TLS=true

# The email address you send newsletters from
FROM_EMAIL=djweirdnasty@gmail.com
FROM_NAME=DJWEIRDNASTY

# Admin credentials (change these!)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# CORS — your website URL
WEBSITE_URL=https://djweirdnasty.com

# Database (SQLite file path)
DATABASE_URL=sqlite:///./newsletter.db
